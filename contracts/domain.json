    "CRATE_LINKED",
    "CRATE_GATE_SIGNED",
    "CRATE_RELEASED",
    "CRATE_HANDED_OVER",
    "CRATE_SUSPENDED",
    "CRATE_RESUMED",
    "ACK_RECEIVED",
    "ACK_CONFLICT_FLAGGED",
    "ACK_RESOLVED",
